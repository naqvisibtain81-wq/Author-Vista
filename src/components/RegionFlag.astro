---
interface Props { code: "us" | "gb" | "au" | "ca" | "eu"; label: string; }
const { code, label } = Astro.props;
---
<span class="region-indicator">
  {code === "us" && <svg viewBox="0 0 38 24" aria-hidden="true"><rect width="38" height="24" fill="#f5f1e9"/><path d="M0 2h38M0 6h38M0 10h38M0 14h38M0 18h38M0 22h38" stroke="#a8443f" stroke-width="2"/><rect width="16" height="12" fill="#263b55"/><g fill="#f5f1e9"><circle cx="3" cy="3" r=".7"/><circle cx="7" cy="3" r=".7"/><circle cx="11" cy="3" r=".7"/><circle cx="14" cy="3" r=".7"/><circle cx="5" cy="6" r=".7"/><circle cx="9" cy="6" r=".7"/><circle cx="13" cy="6" r=".7"/><circle cx="3" cy="9" r=".7"/><circle cx="7" cy="9" r=".7"/><circle cx="11" cy="9" r=".7"/></g></svg>}
  {code === "gb" && <svg viewBox="0 0 38 24" aria-hidden="true"><rect width="38" height="24" fill="#243750"/><path d="M0 0l38 24M38 0L0 24" stroke="#f5f1e9" stroke-width="5"/><path d="M0 0l38 24M38 0L0 24" stroke="#a8443f" stroke-width="2"/><path d="M19 0v24M0 12h38" stroke="#f5f1e9" stroke-width="7"/><path d="M19 0v24M0 12h38" stroke="#a8443f" stroke-width="3.5"/></svg>}
  {code === "au" && <svg viewBox="0 0 38 24" aria-hidden="true"><rect width="38" height="24" fill="#203a5a"/><g fill="#f5f1e9"><circle cx="28" cy="6" r="1.2"/><circle cx="31" cy="12" r="1"/><circle cx="25" cy="16" r="1"/><circle cx="34" cy="19" r="1"/><circle cx="18" cy="13" r="1.4"/></g><path d="M0 0l15 10M15 0L0 10" stroke="#f5f1e9" stroke-width="3"/><path d="M7.5 0v10M0 5h15" stroke="#f5f1e9" stroke-width="4"/><path d="M7.5 0v10M0 5h15" stroke="#a8443f" stroke-width="2"/></svg>}
  {code === "ca" && <svg viewBox="0 0 38 24" aria-hidden="true"><rect width="38" height="24" fill="#f5f1e9"/><path d="M0 0h9v24H0zM29 0h9v24h-9z" fill="#a8443f"/><path d="M19 4l1.5 4 3-1.2-1.4 3 3.2 1.2-3.6 2 1 3-3.1-.7-.6 4.7-.6-4.7-3.1.7 1-3-3.6-2 3.2-1.2-1.4-3 3 1.2z" fill="#a8443f"/></svg>}
  {code === "eu" && <svg viewBox="0 0 38 24" aria-hidden="true"><rect width="38" height="24" fill="#254b78"/><g fill="#e3c45f"><circle cx="19" cy="4" r=".8"/><circle cx="23" cy="5.2" r=".8"/><circle cx="26" cy="8" r=".8"/><circle cx="27" cy="12" r=".8"/><circle cx="26" cy="16" r=".8"/><circle cx="23" cy="18.8" r=".8"/><circle cx="19" cy="20" r=".8"/><circle cx="15" cy="18.8" r=".8"/><circle cx="12" cy="16" r=".8"/><circle cx="11" cy="12" r=".8"/><circle cx="12" cy="8" r=".8"/><circle cx="15" cy="5.2" r=".8"/></g></svg>}
  <span>{label}</span>
</span>
