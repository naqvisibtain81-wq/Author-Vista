---
interface Props { mode?: "call" | "quote" | "contact"; }
const { mode = "call" } = Astro.props;
const buttonLabel = mode === "quote" ? "Prepare my project summary" : mode === "contact" ? "Prepare my enquiry" : "Prepare my call request";
const successMessage = mode === "quote"
  ? "Thank you. Your project summary is in — we'll review it and follow up by email with next steps."
  : mode === "contact"
  ? "Thank you. Your message is in — we'll get back to you by email shortly."
  : "Thank you. Your call request is in — we'll email you to schedule your introductory conversation.";
---
<form data-preview-form novalidate data-success-message={successMessage}>
  <div class="field-row">
    <div class="field"><label for={`${mode}-name`}>Name</label><input id={`${mode}-name`} name="name" autocomplete="name" placeholder="Jane Doe" required /></div>
    <div class="field"><label for={`${mode}-email`}>Email address</label><input id={`${mode}-email`} name="email" type="email" autocomplete="email" placeholder="you@example.com" required /></div>
  </div>
  <div class="field-row">
    <div class="field"><label for={`${mode}-stage`}>Current manuscript stage</label><select id={`${mode}-stage`} name="stage" required><option value="">Select one</option><option>Idea or notes</option><option>Partial manuscript</option><option>Complete manuscript</option><option>Published book</option></select></div>
    <div class="field"><label for={`${mode}-genre`}>Book genre</label><input id={`${mode}-genre`} name="genre" placeholder="e.g. memoir, business, fiction" required /></div>
  </div>
  <div class="field"><label for={`${mode}-services`}>What kind of support are you considering?</label><input id={`${mode}-services`} name="services" placeholder="Writing, editing, design, publishing, marketing…" required /></div>
  <div class="field"><label for={`${mode}-message`}>Tell us briefly about the book and your goal</label><textarea id={`${mode}-message`} name="message" placeholder="A few sentences about your book, where it stands today, and what you're hoping for." required></textarea></div>
  <label class="consent"><input type="checkbox" name="consent" required /> <span>I agree to be contacted about this enquiry in line with the <a href="/privacy-policy/">Privacy Policy</a>.</span></label>
  <p class="form-note">Do not include confidential manuscript text or upload files at this stage.</p>
  <div class="form-status" role="status" aria-live="polite"></div>
  <button class="button" type="submit">{buttonLabel}</button>
</form>
<script>
  document.querySelectorAll<HTMLFormElement>("[data-preview-form]").forEach((form) => {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const status = form.querySelector<HTMLElement>(".form-status");
      if (!form.checkValidity()) {
        form.reportValidity();
        if (status) { status.textContent = "Please complete the required fields before continuing."; status.dataset.visible = ""; }
        return;
      }
      if (status) { status.textContent = form.dataset.successMessage ?? "Thank you. We'll be in touch shortly."; status.dataset.visible = ""; }
      form.reset();
    });
  });
</script>
<style>.consent{display:grid;grid-template-columns:20px 1fr;gap:.65rem;font-weight:400;font-size:.92rem;align-items:start}.consent input{width:18px;min-height:18px;margin-top:.2rem}.consent a{color:inherit}</style>
