<section class="particle-scroll" data-particle-scroll aria-labelledby="particle-trust-title">
  <div class="particle-stage">
    <canvas aria-hidden="true"></canvas>
    <div class="shell particle-copy">
      <p class="eyebrow light">Credibility by design</p>
      <h2
        id="particle-trust-title"
        aria-label="Trust should come from clarity, boundaries and the quality of the work. Never from an invented history."
      >
        <span class="particle-line" aria-hidden="true">
          <span class="particle-word">Trust</span> <span class="particle-word">should</span> <span class="particle-word">come</span> <span class="particle-word">from</span>
        </span>
        <span class="particle-line" aria-hidden="true">
          <span class="particle-word clarity">clarity,</span> <span class="particle-word boundaries">boundaries</span> <span class="particle-word">and</span>
        </span>
        <span class="particle-line" aria-hidden="true">
          <span class="particle-word quality">the</span> <span class="particle-word quality">quality</span> <span class="particle-word quality">of</span> <span class="particle-word quality">the</span> <span class="particle-word quality">work.</span>
        </span>
        <span class="particle-line" aria-hidden="true">
          <span class="particle-word">Never</span> <span class="particle-word">from</span> <span class="particle-word">an</span> <span class="particle-word">invented</span>
        </span>
        <span class="particle-line" aria-hidden="true"><span class="particle-word">history.</span></span>
      </h2>
      <p class="particle-instruction" aria-hidden="true">Scroll to bring the statement into focus</p>
    </div>
    <div class="particle-progress" aria-hidden="true"><span></span></div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-particle-scroll]:not([data-particle-ready])").forEach((section) => {
    section.dataset.particleReady = "";
    const canvas = section.querySelector<HTMLCanvasElement>("canvas");
    const stage = section.querySelector<HTMLElement>(".particle-stage");
    const words = [...section.querySelectorAll<HTMLElement>(".particle-word")];
    if (!canvas || !stage || !words.length) return;
    const context = canvas.getContext("2d", { alpha: true, willReadFrequently: true });
    if (!context) return;
    const forceReduced = new URLSearchParams(location.search).has("reduced-motion");
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");
    if (reduced.matches || forceReduced) {
      section.style.setProperty("--particle-progress", "1");
      section.setAttribute("data-complete", "");
      return;
    }

    type Particle = { fromX:number; fromY:number; x:number; y:number; color:string; size:number; phase:number };
    let particles: Particle[] = [];
    let width = 0;
    let height = 0;
    let ratio = 1;
    let requested = 0;
    let preparing = false;

    const seeded = (value:number) => {
      const result = Math.sin(value * 9283.17) * 43758.5453;
      return result - Math.floor(result);
    };

    const prepare = () => {
      if (preparing) return;
      preparing = true;
      const stageRect = stage.getBoundingClientRect();
      width = Math.max(320, stageRect.width);
      height = Math.max(560, stageRect.height);
      ratio = Math.min(devicePixelRatio || 1, 1.35);
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
      context.clearRect(0, 0, width, height);
      context.textBaseline = "alphabetic";

      words.forEach((word) => {
        const rect = word.getBoundingClientRect();
        const style = getComputedStyle(word);
        const fontSize = Number.parseFloat(style.fontSize);
        context.font = `${style.fontStyle} ${style.fontWeight} ${fontSize}px ${style.fontFamily}`;
        if ("letterSpacing" in context) (context as CanvasRenderingContext2D & { letterSpacing:string }).letterSpacing = style.letterSpacing;
        const metrics = context.measureText(word.textContent ?? "");
        const glyphHeight = metrics.actualBoundingBoxAscent + metrics.actualBoundingBoxDescent;
        const baseline = rect.top - stageRect.top + Math.max(0, (rect.height - glyphHeight) / 2) + metrics.actualBoundingBoxAscent;
        context.fillStyle = style.color;
        context.fillText(word.textContent ?? "", rect.left - stageRect.left, baseline);
      });

      const image = context.getImageData(0, 0, canvas.width, canvas.height).data;
      particles = [];
      const step = Math.max(3, Math.round(3.6 * ratio));
      let seed = 1;
      for (let py = 0; py < canvas.height; py += step) for (let px = 0; px < canvas.width; px += step) {
        const at = (py * canvas.width + px) * 4;
        if (image[at + 3] < 75 || seeded(seed++) < .16) continue;
        const targetX = px / ratio;
        const targetY = py / ratio;
        const angle = seeded(seed++) * Math.PI * 2;
        const distance = Math.min(width, height) * (.16 + seeded(seed++) * .48);
        particles.push({
          fromX: targetX + Math.cos(angle) * distance,
          fromY: targetY + Math.sin(angle) * distance * .62,
          x: targetX,
          y: targetY,
          color: `rgb(${image[at]},${image[at + 1]},${image[at + 2]})`,
          size: .45 + seeded(seed++) * 1.05,
          phase: seeded(seed++) * .16,
        });
      }
      context.clearRect(0, 0, width, height);
      preparing = false;
    };

    const ease = (value:number) => value < .5 ? 4 * value * value * value : 1 - Math.pow(-2 * value + 2, 3) / 2;
    const render = () => {
      requested = 0;
      const rect = section.getBoundingClientRect();
      const range = Math.max(1, rect.height - innerHeight);
      const progress = Math.max(0, Math.min(1, -rect.top / range));
      const attraction = ease(Math.max(0, Math.min(1, progress / .82)));
      section.style.setProperty("--particle-progress", progress.toFixed(4));
      section.toggleAttribute("data-complete", progress >= .88);
      context.clearRect(0, 0, width, height);
      const canvasFade = progress > .8 ? Math.max(0, 1 - (progress - .8) / .12) : 1;
      particles.forEach((particle) => {
        const local = Math.max(0, Math.min(1, (attraction - particle.phase) / (1 - particle.phase)));
        const drift = (1 - local) * Math.sin(progress * 8 + particle.phase * 30) * 6;
        const px = particle.fromX + (particle.x - particle.fromX) * local + drift;
        const py = particle.fromY + (particle.y - particle.fromY) * local + drift * .32;
        context.globalAlpha = canvasFade * (.1 + local * .9);
        context.fillStyle = particle.color;
        context.fillRect(px, py, particle.size, particle.size);
      });
      context.globalAlpha = 1;
    };

    const requestRender = () => { if (!requested) requested = requestAnimationFrame(render); };
    const refresh = () => { prepare(); requestRender(); };
    const resizeObserver = new ResizeObserver(refresh);
    resizeObserver.observe(stage);
    document.fonts.ready.then(refresh);
    prepare();
    render();
    addEventListener("scroll", requestRender, { passive: true });
    addEventListener("resize", refresh, { passive: true });
    addEventListener("pagehide", () => {
      removeEventListener("scroll", requestRender);
      removeEventListener("resize", refresh);
      resizeObserver.disconnect();
      cancelAnimationFrame(requested);
    }, { once: true });
  });
</script>
