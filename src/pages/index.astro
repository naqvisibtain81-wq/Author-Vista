---
import BaseLayout from "../layouts/BaseLayout.astro";
import EditorialCarousel from "../components/EditorialCarousel.astro";
import { stages, serviceGroups, faqs } from "../data/site";
const isProduction = import.meta.env.PUBLIC_SITE_STATUS === "production";
const faqSchema = { "@type": "FAQPage", mainEntity: faqs.map(([question,answer]) => ({ "@type": "Question", name: question, acceptedAnswer: { "@type": "Answer", text: answer } })) };
const authorRealitySlides = [
  { eyebrow: "An idea waiting for direction", title: "You know the idea matters, but not yet how to structure it.", text: "Clarify the purpose, reader and shape of the book before the blank page becomes a source of pressure.", image: "/images/writer-city.webp", alt: "A writer thinking while developing ideas in a notebook", width: 1800, height: 1200, position: "center 42%", href: "/services/book-writing-and-manuscript-development/", linkLabel: "Explore manuscript development" },
  { eyebrow: "A draft waiting for distance", title: "You have lived with the manuscript so long that objectivity is hard to find.", text: "The right editorial perspective can reveal structural gaps, unclear passages and opportunities already present in the work.", image: "/images/writer-evening.webp", alt: "A writer working on a manuscript at home in the evening", width: 1200, height: 1800, position: "center 44%", href: "/services/book-editing/", linkLabel: "Understand editorial support" },
  { eyebrow: "A voice worth protecting", title: "You want professional help without losing what made the book yours.", text: "Writing and editing support should strengthen the manuscript while preserving the author’s intent, character and approval.", image: "/images/writer-home.webp", alt: "A writer reviewing notes at a calm home desk", width: 1200, height: 1800, position: "center 38%", href: "/how-it-works/", linkLabel: "See how collaboration works" },
];
---
<BaseLayout title="Publishing Services for Independent Authors | Author Vista" description="Writing, editing, design, publishing and marketing support for independent authors, thoughtfully coordinated while you retain control." schema={faqSchema} image="/images/editor-reviewing-pages.webp">
  <section class="cinematic-hero ink-scene" aria-labelledby="hero-title" data-depth-scene>
    <div class="hero-photograph" data-parallax>
      <img src="/images/editor-reviewing-pages.webp" width="1800" height="1440" alt="An editor reviewing printed pages beside a laptop" fetchpriority="high" />
    </div>
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="shell hero-content">
      <div class="hero-copy">
        <h1 id="hero-title" class="phrase-title">
          <span><i>A clearer path</i></span>
          <span><i>from the book you imagine</i></span>
          <span><i>to the book your readers can hold.</i></span>
        </h1>
        <p class="hero-intro">Author Vista coordinates writing, editing, design, publishing and marketing support around your book, while you remain in control of the work.</p>
        <div class="hero-actions"><a class="button" href="/schedule-a-call/">Schedule an introductory call</a><a class="text-link light" href="#publishing-process">Explore our publishing process <span>↓</span></a></div>
      </div>
    </div>
    <div class="scroll-cue" aria-hidden="true"><span>Scroll to open the view</span><i></i></div>
    <div class="hero-horizon" aria-hidden="true"></div>
  </section>

  <nav class="sr-only" aria-label="Homepage chapters">
    <a href="#your-stage">The manuscript</a>
    <a href="#view-opens">The view opens</a>
    <a href="#publishing-process">The craft</a>
    <a href="#ownership">Ownership and control</a>
    <a href="#publication">The publication path</a>
    <a href="#portfolio-preview">Portfolio preview</a>
    <a href="#questions">Author questions</a>
    <a href="#next-step">The next step</a>
  </nav>

  <section class="chapter author-reality" aria-labelledby="reality-title">
    <div class="shell reality-heading" data-sequence><p class="chapter-number light" data-sequence-item>Before chapter one</p><p class="eyebrow light" data-sequence-item>The author’s reality</p><h2 id="reality-title" data-sequence-item>A manuscript can matter deeply and still feel difficult to move forward.</h2><p class="lede" data-sequence-item>Professional support begins by recognising the problem in front of the author, not by assuming every book needs the same solution.</p></div>
    <EditorialCarousel label="Common manuscript starting points" slides={authorRealitySlides} mode="story" cinematic />
  </section>

  <section id="your-stage" class="chapter chapter-stages">
    <div class="shell stage-composition">
      <div class="stage-intro" data-sequence><p class="chapter-number" data-sequence-item>Chapter one</p><p class="eyebrow" data-sequence-item>Every book begins somewhere</p><h2 data-sequence-item>Begin with the manuscript you actually have.</h2><p class="lede" data-sequence-item>You do not need a perfect draft or the right publishing vocabulary. You only need to know where the book stands today.</p></div>
      <div class="page-stack" aria-hidden="true" data-parallax data-depth-scene><div class="paper paper-back"><span>Idea</span></div><div class="paper paper-middle"><span>Draft</span><i></i><i></i><i></i></div><div class="paper paper-front"><span>Manuscript</span><b>What could this become?</b><i></i><i></i><i></i><i></i></div></div>
      <div class="stage-paths" data-sequence>
        {stages.map((stage,index) => <a class="stage-path" href={stage.href} data-sequence-item><span class="stage-number">{stage.number}</span><div><p>{stage.eyebrow}</p><h3>{index === 0 ? "An idea waiting for direction" : index === 1 ? "A draft waiting for refinement" : "A manuscript waiting for publication"}</h3><span>{stage.text}</span></div><b aria-hidden="true">↗</b></a>)}
      </div>
    </div>
  </section>

  <section id="view-opens" class="chapter chapter-vista vista-dust-reveal" data-vista-dust aria-labelledby="vista-title">
    <div class="vista-dust-atmosphere" aria-hidden="true"></div>
    <canvas class="vista-dust-canvas" data-vista-dust-canvas aria-hidden="true"></canvas>
    <div class="shell vista-dust-content">
        <h2 id="vista-title" class="vista-dust-statement">
          <span class="vista-dust-line vista-dust-line-one">Authors need more than isolated services.</span>
          <span class="vista-dust-line vista-dust-line-two">They need a clear view of <em>the whole path ahead.</em></span>
        </h2>
        <div class="vista-dust-support">
          <p>Author Vista brings the creative, editorial and technical stages into one considered process. Each decision is made with the finished book in view.</p>
          <a class="text-link light" href="/about/">Discover the thinking behind Author Vista <span aria-hidden="true">&rarr;</span></a>
        </div>
        <div class="vista-dust-horizon" aria-hidden="true"></div>
    </div>
  </section>

  <section id="publishing-process" class="chapter craft-chapter" data-depth-scene>
    <div class="shell craft-layout">
      <div class="craft-sticky">
        <div data-sequence><p class="chapter-number" data-sequence-item>Chapter three</p><p class="eyebrow" data-sequence-item>Craft in motion</p><h2 data-sequence-item>One manuscript, shaped through connected decisions.</h2><p class="lede" data-sequence-item>Move through the stages to see how the work develops. Not every project needs every service.</p></div>
      </div>
      <div class="craft-steps">
        {serviceGroups.map((service,index) => <article class="craft-step" data-craft-step data-number={`0${index+1}`} data-label={service.shortTitle} data-reveal><div class:list={["craft-motif", `craft-${service.visualMode}`]} aria-hidden="true"><span></span><i></i><i></i><i></i><b>{`0${index+1}`}</b></div><span>{`0${index+1}`}</span><p class="eyebrow">{["Writing","Editing","Design","Publishing","Audio","Author platform"][index]}</p><h3>{service.shortTitle}</h3><p>{service.intro}</p><a class="text-link" href={`/services/${service.slug}/`}>Explore this service <b>→</b></a></article>)}
      </div>
    </div>
  </section>

  <section class="chapter collaboration-chapter" aria-labelledby="collaboration-title">
    <div class="collaboration-image" data-image-reveal data-parallax><img src="/images/publishing-discussion.webp" width="1800" height="1202" alt="People reviewing documents together around a table" loading="lazy" /></div>
    <div class="collaboration-shade" aria-hidden="true"></div>
    <div class="shell collaboration-content" data-sequence><p class="chapter-number light" data-sequence-item>Between craft and control</p><p class="eyebrow light" data-sequence-item>Human collaboration</p><h2 id="collaboration-title" data-sequence-item>The book is yours. The path does not have to be taken alone.</h2><p data-sequence-item>Good collaboration is not a handoff into the unknown. It is a sequence of conversations, reviews and approvals that keeps the author close to the work while specialist support moves it forward.</p><p class="image-context" data-sequence-item>Editorial photography illustrates a publishing discussion. People shown are not identified as Author Vista staff or clients.</p><a class="text-link light" href="/how-it-works/" data-sequence-item>See how the process keeps decisions visible <span>→</span></a></div>
  </section>

  <section id="ownership" class="chapter trust-chapter">
    <div class="shell trust-layout">
      <div class="trust-heading" data-reveal><p class="chapter-number">Chapter four</p><p class="eyebrow">Your book remains yours</p><h2>Professional support without surrendering control.</h2><p class="lede">The work is collaborative. The ownership is not ambiguous.</p></div>
      <ol class="trust-ledger" data-sequence>
        <li data-sequence-item><span>01</span><div><h3>Copyright stays with you.</h3><p>You retain copyright in your manuscript and book content.</p></div></li>
        <li data-sequence-item><span>02</span><div><h3>Publishing accounts stay under your control.</h3><p>You hold and control platform accounts wherever the selected platform permits.</p></div></li>
        <li data-sequence-item><span>03</span><div><h3>Royalties remain yours.</h3><p>Author Vista does not claim an ongoing share of royalties.</p></div></li>
        <li data-sequence-item><span>04</span><div><h3>Major decisions require approval.</h3><p>Creative and publishing decisions are reviewed at the agreed project milestones.</p></div></li>
        <li data-sequence-item><span>05</span><div><h3>The scope reflects the book.</h3><p>Services are quoted according to manuscript condition, formats, goals and timeline.</p></div></li>
      </ol>
    </div>
  </section>

  <section id="publication" class="chapter publication-chapter ink-scene" aria-labelledby="publication-title" data-depth-scene>
    <div class="publication-horizon" aria-hidden="true"><i></i><i></i><i></i><span></span></div>
    <div class="shell publication-layout">
      <div class="publication-copy" data-sequence>
        <p class="chapter-number light" data-sequence-item>Chapter five</p>
        <p class="eyebrow light" data-sequence-item>The publication path</p>
        <h2 id="publication-title" data-sequence-item>Your book moves outward. Your publishing identity stays with you.</h2>
        <p data-sequence-item>Author Vista can prepare files, metadata, descriptions, categories and submission materials, then guide you through established self publishing and distribution platforms.</p>
        <a class="text-link light" href="/publishing-services/" data-sequence-item>Understand publishing assistance <span>→</span></a>
      </div>
      <div class="platform-orbit" data-sequence aria-label="Platforms that may be considered according to the project">
        {['Amazon KDP','IngramSpark','Lulu','Apple Books','Kobo','Barnes & Noble, where available'].map((platform,index) => <div data-sequence-item><span>{`0${index+1}`}</span><p>{platform}</p></div>)}
        <p class="platform-note" data-sequence-item>Platform options depend on the project. No partnership or preferred access is implied.</p>
      </div>
    </div>
  </section>

  {!isProduction && <section id="portfolio-preview" class="chapter portfolio-preview" aria-labelledby="portfolio-title">
    <div class="shell"><div class="portfolio-heading" data-reveal><div><p class="chapter-number light">Chapter six</p><p class="eyebrow light">Books that can be held</p><h2 id="portfolio-title">A place reserved for real books.</h2></div><p>This preview composition will hold approved cover artwork, production details and project context. It is not presented as a published Author Vista portfolio.</p></div>
      <div class="shelf-preview" aria-label="Development placeholders for future approved portfolio books"><div class="placeholder-book"><span>Development placeholder</span><b>Approved project<br />coming here</b></div><div class="placeholder-pages"><i></i><i></i><i></i><p>Real title, author permission, services and publication link required.</p></div></div>
    </div>
  </section>}

  <section id="direct-answer" class="section answer-chapter"><div class="shell answer-layout"><div data-reveal><p class="eyebrow">A direct answer</p><h2>What is Author Vista?</h2></div><p data-reveal>Author Vista is an end to end publishing services partner. It helps authors move from an early idea or unfinished manuscript to a professionally prepared, independently published book. It is not a traditional publisher. Authors retain control of their work, publishing identity and royalties.</p></div></section>

  <section id="questions" class="section-tight faq-chapter"><div class="shell faq-layout"><div data-reveal><p class="eyebrow">Questions authors ask</p><h2>Clarity before commitment.</h2><a class="text-link" href="/frequently-asked-questions/">View every answer <span>→</span></a></div><div class="faq-list" data-sequence>{faqs.slice(0,5).map(([question,answer]) => <details data-sequence-item><summary>{question}</summary><p>{answer}</p></details>)}</div></div></section>

  <section id="next-step" class="final-horizon ink-scene">
    <div class="final-light" aria-hidden="true"></div><div class="shell final-content" data-reveal><p class="chapter-number light">The next page</p><p class="eyebrow light">A clearer next step</p><h2>Your book may still be an idea, a draft or a finished manuscript.</h2><p>The next step begins with understanding where you are.</p><a class="button button-light" href="/schedule-a-call/">Schedule an introductory call</a></div>
  </section>
</BaseLayout>

<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const vistaSection = document.querySelector<HTMLElement>("[data-vista-dust]");
  if (vistaSection) {
    const forceReducedVista = new URLSearchParams(location.search).has("reduced-motion");
    const motionEnabled = !reduced && !forceReducedVista;
    const canvas = vistaSection.querySelector<HTMLCanvasElement>("[data-vista-dust-canvas]");
    if (!motionEnabled || !canvas) {
      vistaSection.toggleAttribute("data-vista-reduced", true);
    } else {
      const context = canvas.getContext("2d", { alpha: true });
      const clamp = (value: number) => Math.max(0, Math.min(1, value));
      const range = (value: number, start: number, end: number) => clamp((value - start) / (end - start));
      const ease = (value: number) => 1 - Math.pow(1 - value, 3);
      const particles: Array<{ y:number; offset:number; speed:number; size:number; alpha:number; drift:number; color:string }> = [];
      let frame = 0;
      let startTime = 0;
      let pauseTime = 0;
      let running = false;
      let complete = false;
      const duration = 3000;

      const setReveal = (progress: number) => {
        vistaSection.style.setProperty("--dust-line-one", ease(range(progress, .06, .43)).toFixed(4));
        vistaSection.style.setProperty("--dust-line-two", ease(range(progress, .2, .62)).toFixed(4));
        vistaSection.style.setProperty("--dust-accent", ease(range(progress, .34, .72)).toFixed(4));
        vistaSection.style.setProperty("--dust-support", ease(range(progress, .62, .87)).toFixed(4));
        vistaSection.style.setProperty("--dust-link", ease(range(progress, .78, .98)).toFixed(4));
      };

      const sizeCanvas = () => {
        if (!context || complete) return;
        const rect = vistaSection.getBoundingClientRect();
        const ratio = Math.min(devicePixelRatio || 1, 2);
        canvas.width = Math.max(1, Math.round(rect.width * ratio));
        canvas.height = Math.max(1, Math.round(rect.height * ratio));
        canvas.style.width = `${rect.width}px`;
        canvas.style.height = `${rect.height}px`;
        context.setTransform(ratio, 0, 0, ratio, 0, 0);
        particles.length = 0;
        const count = innerWidth < 700 ? 100 : 190;
        const colors = ["243,237,226", "184,111,75", "151,168,157"];
        for (let index = 0; index < count; index += 1) particles.push({
          y: Math.random() * rect.height,
          offset: Math.random() * rect.width * .62,
          speed: .72 + Math.random() * .7,
          size: .35 + Math.random() * 1.15,
          alpha: .035 + Math.random() * .13,
          drift: (Math.random() - .5) * 26,
          color: colors[index % colors.length]
        });
      };

      const drawDust = (progress: number) => {
        if (!context) return;
        const width = canvas.clientWidth;
        const height = canvas.clientHeight;
        context.clearRect(0, 0, width, height);
        const fade = Math.min(1, progress * 7) * (1 - ease(range(progress, .72, 1)));
        const front = -width * .12 + progress * width * 1.42;
        for (const particle of particles) {
          const x = front * particle.speed - particle.offset;
          if (x < -20 || x > width + 20) continue;
          const y = particle.y + Math.sin(progress * 8 + particle.offset * .01) * particle.drift;
          context.beginPath();
          context.fillStyle = `rgba(${particle.color},${particle.alpha * fade})`;
          context.ellipse(x, y, particle.size * 2.4, particle.size, -.16, 0, Math.PI * 2);
          context.fill();
        }
      };

      const finish = () => {
        complete = true;
        running = false;
        frame = 0;
        setReveal(1);
        context?.clearRect(0, 0, canvas.clientWidth, canvas.clientHeight);
        canvas.hidden = true;
        vistaSection.toggleAttribute("data-dust-revealed", true);
        removeEventListener("resize", sizeCanvas);
        removeEventListener("visibilitychange", handleVisibility);
      };

      const renderDust = (time: number) => {
        if (!running || document.hidden) return;
        if (!startTime) startTime = time;
        const progress = clamp((time - startTime) / duration);
        setReveal(progress);
        drawDust(progress);
        if (progress >= 1) finish();
        else frame = requestAnimationFrame(renderDust);
      };

      const handleVisibility = () => {
        if (complete || !running) return;
        if (document.hidden) {
          pauseTime = performance.now();
          if (frame) cancelAnimationFrame(frame);
          frame = 0;
        } else {
          if (pauseTime && startTime) startTime += performance.now() - pauseTime;
          pauseTime = 0;
          frame = requestAnimationFrame(renderDust);
        }
      };

      setReveal(0);
      sizeCanvas();
      vistaSection.toggleAttribute("data-dust-ready", true);
      const vistaObserver = new IntersectionObserver(([entry]) => {
        if (!entry.isIntersecting || running || complete) return;
        running = true;
        vistaObserver.disconnect();
        frame = requestAnimationFrame(renderDust);
      }, { threshold: .01, rootMargin: "0px 0px -70% 0px" });
      vistaObserver.observe(vistaSection);
      addEventListener("resize", sizeCanvas, { passive: true });
      addEventListener("visibilitychange", handleVisibility);
      addEventListener("pagehide", () => {
        vistaObserver.disconnect();
        removeEventListener("resize", sizeCanvas);
        removeEventListener("visibilitychange", handleVisibility);
        if (frame) cancelAnimationFrame(frame);
      }, { once: true });
    }
  }
  if (!reduced) {
    const craftNumber = document.querySelector<HTMLElement>("[data-craft-number]");
    const craftLabel = document.querySelector<HTMLElement>("[data-craft-label]");
    const craftObserver = new IntersectionObserver((entries) => entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      const step = entry.target as HTMLElement;
      if (craftNumber) craftNumber.textContent = step.dataset.number ?? "";
      if (craftLabel) craftLabel.textContent = step.dataset.label ?? "";
      document.querySelectorAll("[data-craft-step]").forEach((item) => item.toggleAttribute("data-active", item === step));
    }), { threshold: .58, rootMargin: "-15% 0px -15%" });
    document.querySelectorAll("[data-craft-step]").forEach((step) => craftObserver.observe(step));
  }
</script>

<style>
.cinematic-hero{position:relative;min-height:100svh;display:flex;align-items:flex-end;overflow:hidden;padding:clamp(6.5rem,11vh,8.5rem) 0 clamp(4rem,7vh,6rem)}.hero-photograph{position:absolute;inset:-4% -2% -4% 37%;transform:translate3d(0,var(--parallax),0);will-change:transform}.hero-photograph img{width:100%;height:110%;object-fit:cover;object-position:55% center;filter:saturate(.54) sepia(.18) contrast(1.07)}.hero-shade{position:absolute;inset:0;background:linear-gradient(90deg,#0b1217 0%,rgba(11,18,23,.95) 32%,rgba(11,18,23,.52) 65%,rgba(11,18,23,.12)),linear-gradient(0deg,rgba(6,11,14,.88),transparent 52%),radial-gradient(circle at 72% 38%,rgba(184,111,75,.18),transparent 35%)}.hero-content{position:relative;z-index:2}.hero-copy{max-width:960px}.phrase-title{font-size:clamp(2.6rem,5.6vw,6.4rem);max-width:12.7ch;color:var(--paper)}.phrase-title>span{display:block;overflow:hidden;padding-bottom:.08em;margin-bottom:-.08em}.phrase-title i{display:block;font-style:normal;transform:translateY(110%);animation:lineRise 1s var(--ease) forwards}.phrase-title>span:nth-child(2) i{animation-delay:.13s}.phrase-title>span:nth-child(3) i{animation-delay:.26s;color:#e7c9b4}.hero-intro{max-width:58ch;color:#ced5d0;font-size:clamp(1.05rem,1.3vw,1.2rem);margin-top:1.25rem;opacity:0;animation:quietIn .9s .55s var(--ease) forwards}.hero-actions{display:flex;align-items:center;gap:1.8rem;flex-wrap:wrap;margin-top:1.5rem;opacity:0;animation:quietIn .9s .7s var(--ease) forwards}.scroll-cue{position:absolute;z-index:3;right:3vw;bottom:2.8rem;display:flex;align-items:center;gap:1rem;color:#bac4be;font-size:.68rem;text-transform:uppercase;letter-spacing:.18em;writing-mode:vertical-rl}.scroll-cue i{display:block;width:1px;height:58px;background:linear-gradient(var(--copper),transparent)}.hero-horizon{position:absolute;z-index:2;left:0;right:0;bottom:0;height:1px;background:linear-gradient(90deg,transparent,var(--copper) 32%,#e0a284 62%,transparent);box-shadow:0 0 34px rgba(184,111,75,.5)}
