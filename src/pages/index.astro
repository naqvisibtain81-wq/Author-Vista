---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Development in Progress | Author Vista"
  description="The Author Vista website is currently in development."
  noindex
  minimal
>
  <section class="development-screen" aria-labelledby="development-title">
    <div class="development-message">
      <p class="development-label">Author Vista</p>
      <h1 id="development-title">Development in progress</h1>
      <p>We&apos;re working on the website and will be back soon.</p>
    </div>
  </section>
</BaseLayout>

<style>
  :global(html),
  :global(body.minimal-page) {
    min-height: 100%;
    background: #000;
  }

  :global(body.minimal-page::before) {
    display: none;
  }

  :global(body.minimal-page main) {
    margin: 0;
  }

  .development-screen {
    display: grid;
    min-height: 100svh;
    place-items: center;
    padding: 2rem;
    background: #000;
    color: #fff;
    text-align: center;
  }

  .development-message {
    width: min(100%, 42rem);
  }

  .development-label {
    margin: 0 0 1.5rem;
    color: #aaa;
    font-size: .75rem;
    font-weight: 600;
    letter-spacing: .2em;
    text-transform: uppercase;
  }

  .development-screen h1 {
    font-size: clamp(2.25rem, 7vw, 4.5rem);
    line-height: 1.05;
  }

  .development-message > p:last-child {
    margin: 1.25rem 0 0;
    color: #aaa;
    font-size: clamp(1rem, 2vw, 1.15rem);
  }

  @media (max-width: 480px) {
    .development-screen {
      padding: 1.5rem;
    }
  }
</style>
