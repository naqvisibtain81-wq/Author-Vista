---
import BaseLayout from "../layouts/BaseLayout.astro"; import PageHero from "../components/PageHero.astro";
---
<BaseLayout title="Cancellation Policy, Preview Status" description="Preview status for the Author Vista cancellation or refund policy." noindex={true}>
  <PageHero eyebrow="Legal content pending" title="Cancellation policy" intro="Project cancellation, refund and rescheduling terms have not yet been approved." />
  <section class="section"><div class="shell narrow prose"><p class="notice">Launch blocker: deposit treatment, milestone cancellation, work already completed, third party costs, rescheduling and jurisdictional consumer rights must be defined in the client agreement and reviewed before publication.</p></div></section>
</BaseLayout>
