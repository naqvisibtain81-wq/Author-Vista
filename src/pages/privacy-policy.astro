---
import BaseLayout from "../layouts/BaseLayout.astro"; import PageHero from "../components/PageHero.astro";
---
<BaseLayout title="Privacy Policy, Preview Status" description="Preview status for the Author Vista privacy policy." noindex={true}>
  <PageHero eyebrow="Legal content pending" title="Privacy policy" intro="A production privacy policy has not yet been supplied or legally reviewed." />
  <section class="section"><div class="shell narrow prose"><p class="notice">Launch blocker: legal entity, contact details, service providers, data handling procedures, retention periods, user rights and applicable jurisdictions must be confirmed before this page can be published.</p><p>The preview enquiry forms do not transmit or store personal information.</p></div></section>
</BaseLayout>
