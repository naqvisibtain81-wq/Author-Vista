---
import BaseLayout from "../layouts/BaseLayout.astro"; import PageHero from "../components/PageHero.astro";
---
<BaseLayout title="Page Not Found" description="The requested Author Vista page could not be found." noindex={true}>
  <PageHero eyebrow="404, beyond the map" title="This page is no longer on the horizon." intro="The address may have changed, or the page may not exist. Return to the publishing path or explore the services available for your manuscript." />
  <section class="section-tight"><div class="shell narrow"><a class="button" href="/">Return home</a> <a class="button button-outline" href="/services/">Explore services</a></div></section>
</BaseLayout>
