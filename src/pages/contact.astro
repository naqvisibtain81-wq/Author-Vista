---
import BaseLayout from "../layouts/BaseLayout.astro"; import PageHero from "../components/PageHero.astro"; import InquiryForm from "../components/InquiryForm.astro";
---
<BaseLayout title="Contact Author Vista" description="Contact Author Vista about writing, editing, design, assisted self publishing, audiobook or book marketing support." noindex={true}>
  <PageHero eyebrow="Contact" title="A considered first step for your book." intro="You do not need to arrive with every answer. Share where the book stands, what you hope it can become and the kind of support you are considering." />
  <section class="section"><div class="shell form-shell"><div><InquiryForm mode="contact" /></div><aside class="sidebar-note" data-sequence><div class="service-motif motif-voice" aria-hidden="true"><span></span><i></i><i></i><i></i><b>AV</b></div><div data-sequence-item><h2>Supporting authors internationally</h2><p>Author Vista intends to support authors across the United States, United Kingdom, Australia, Canada, the European Union and beyond.</p><p>No physical office location or jurisdiction is claimed in this preview. Public email, phone, working hours and business address remain pending confirmation before launch.</p></div></aside></div></section>
</BaseLayout>
